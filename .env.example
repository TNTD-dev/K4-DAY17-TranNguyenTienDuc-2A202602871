# Offline benchmark/test does not require an .env file or API keys.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
COMPACT_THRESHOLD_TOKENS=1000
COMPACT_KEEP_MESSAGES=4

# Optional judge overrides; omitted values inherit the main model when providers match.
# JUDGE_PROVIDER=gemini
# JUDGE_MODEL=gemini-2.5-flash
# JUDGE_TEMPERATURE=0
# JUDGE_API_KEY=
# JUDGE_BASE_URL=

# Set only the credentials/endpoints for the provider used in live mode.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# CUSTOM_BASE_URL=http://localhost:9000/v1
# CUSTOM_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_API_KEY=

# Generic LLM_API_KEY / LLM_BASE_URL override provider-specific values.
